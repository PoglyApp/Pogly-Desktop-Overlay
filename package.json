{
  "name": "pogly-desktop-overlay",
  "version": "1.0.0",
  "description": "Pogly Desktop Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "gg.pogly.overlay",
    "productName": "Pogly Desktop Overlay",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "pogly.ico",
      "artifactName": "pogly-desktop-overlay-${version}.exe"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}